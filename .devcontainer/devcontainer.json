{
  "name": "epiworld-benchmark",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  // Rootless podman maps container root to the host user, so files written
  // into the bind-mounted checkout keep the host user's ownership. With VS
  // Code, set "dev.containers.dockerPath": "podman" in the user settings.
  "remoteUser": "root",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "postCreateCommand": "make setup",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "ms-python.python",
        "REditorSupport.r",
        "quarto.quarto"
      ]
    }
  }
}
